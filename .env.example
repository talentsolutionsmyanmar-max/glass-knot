# Nansen API key (header: apikey). Leave empty for demo mode.
NANSEN_API_KEY=

# Optional tuning
TRADE_VALUE_USD_MIN=1000
POLL_INTERVAL_SEC=60
HOST=0.0.0.0
PORT=8765

# BFS / grading
BFS_MAX_DEPTH=2
BFS_MAX_RELATED_PER_NODE=8
BFS_MAX_WALLETS=24
FARM_MIN_RELATED=4
SOLO_MAX_RELATED=1
INCLUDE_COUNTERPARTIES=0
USE_PREMIUM_LABELS=0
